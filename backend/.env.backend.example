# Copy to backend/.env before docker compose.
# Use letters and numbers only. These values are substituted into Keycloak at startup.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_USER=nephro
MYSQL_PASSWORD=CHANGE_ME_DB

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK
DIALYSIS_KC_SECRET=CHANGE_ME_DIALYSIS_CLIENT

DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN
DEMO_DOCTOR_PASSWORD=CHANGE_ME_DOCTOR
DEMO_NURSE_PASSWORD=CHANGE_ME_NURSE
DEMO_PATIENT_PASSWORD=CHANGE_ME_PATIENT
DEMO_PHARMACIST_PASSWORD=CHANGE_ME_PHARMACIST
DEMO_LABTECH_PASSWORD=CHANGE_ME_LABTECH
DEMO_DRIVER_PASSWORD=CHANGE_ME_DRIVER

FRONT_ORIGIN=http://localhost:4200
BACK_ORIGIN=http://localhost:4369
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4369
GEMINI_API_KEY=
